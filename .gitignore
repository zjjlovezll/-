__pycache__/
*.py[cod]
.pytest_cache/
.pytest_tmp/
.pytest_tmp*/
# Any pytest basetemp someone points inside the tree (a review run used .pt_tmp_review and left
# a hundred tiny case files behind).
.pt_tmp*/
*.egg-info/
build/
dist/

# Agent state: derived cases, job directories, the revision ledger.  Reproducible from the
# recipes that produced it, and it grows without bound, so it does not belong in history.
.agent/

# Which machine keeps the corpus, and where.  Machine-specific, so not in history; the
# committed example next to it is the template.
.velch-data.json

# Simulation output of anything run in place.  One 1.2 s assembly run is ~8 MB; committing
# them turns the repository into 1.4 GB of duplicated CSV.  The bulk corpus now lives outside
# the repository entirely (see validation/INDEX.md), so these patterns only catch strays.
validation/**/out_*/

# Materialised setup cases: five thousand lines per run, written by velch.setup.resolve
# and reproducible from the setup file it came from.
scratch/setups/

# Generated geometry and modal expansions.  All of it is derivable from the PRR profiles in
# `validation/crh380a_m/bodies` and the SDITT catalogue; `validation/INDEX.md` says how.
validation/**/div_panel/
validation/**/smoothed/
validation/**/smoothed_final/
validation/**/modes_scale_*.json

validation/**/*.png
validation/**/*.log
validation/**/*.err

# Scratch: one-off probes live in .tmp/ and are not part of the package.
.tmp/

# Acceptance reports and ad-hoc renders: regenerated by `scripts/auto_accept.py` on demand, and
# the one picture the docs need is committed under docs/images/ instead.
reports/
dist_installer/
build_installer/

.verify_vehicle_ref/

# build-time copy of vehicles/ into the wheel (setup.py build_py); never a source-tree copy
src/velch/_internal/
